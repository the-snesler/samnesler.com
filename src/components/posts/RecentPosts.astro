---
import { getCollection } from 'astro:content';
import { sortPosts } from '@/utils/utils';

const posts = await getCollection('blog');
const sortedPosts = sortPosts(posts).slice(0, 5);
---

<ul class="mt-2 w-full">
  {
    sortedPosts.map(post => {
      return (
        <li class="mb-4">
          <a href={`/posts/${post.id}`} class="hover:text-accent text-lg font-semibold">
            {post.data.title}
          </a>
          <p class="text-content/75 text-sm">{post.data.subtitle}</p>
        </li>
      );
    })
  }
</ul>
