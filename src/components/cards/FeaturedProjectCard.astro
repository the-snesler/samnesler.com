---
import type { ImageMetadata } from 'astro';
import Image from '@/components/Image.astro';

interface Props {
  name: string;
  href?: string;
  source?: string;
  src: ImageMetadata | string;
  description: string;
  year: string;
  shortType: string;
  containImage?: boolean;
  containBackgroundColor?: string;
}

const { name, href, source, src, description, year, shortType, containImage = false, containBackgroundColor } = Astro.props;
const link = href ?? source;
---

<article
  class="border-bkg group relative flex flex-col overflow-hidden rounded-xl border-2 shadow-sm transition-[translate,filter] duration-200 hover:-translate-y-1.5 hover:border-4 hover:shadow-lg active:translate-y-0 active:brightness-95"
>
  {
    link && (
      <a href={link} class="absolute inset-0 z-10" aria-label={name} target="_blank" rel="noopener noreferrer">
        <span class="visible-hidden">{name}</span>
      </a>
    )
  }
  <div
    class="from-accent relative aspect-16/10 w-full overflow-hidden bg-gradient-to-br to-purple-700"
    style={containBackgroundColor ? `background-color:${containBackgroundColor};` : undefined}
  >
    {
      typeof src === 'string' ? (
        <img
          src={src}
          alt=""
          class:list={[
            'absolute inset-0 h-full w-full transition-transform group-hover:scale-105',
            containImage ? 'object-contain p-6' : 'object-cover'
          ]}
        />
      ) : (
        <Image
          src={src}
          alt=""
          widths={[300, 600, 900]}
          sizes="(max-width: 768px) 100vw, 33vw"
          quality={70}
          class:list={[
            'absolute inset-0 h-full w-full transition-transform group-hover:scale-105',
            containImage ? 'object-contain p-6' : 'object-cover'
          ]}
        />
      )
    }
    <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/70 to-transparent"></div>
    <span class="bg-bkg/90 text-content absolute bottom-3 left-3 rounded-full px-3 py-1 font-mono text-sm backdrop-blur-sm">{shortType}</span>
  </div>
  <div class="bg-bkg flex flex-1 flex-col gap-1 p-4">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="font-mono text-lg font-bold">{name}</h3>
      <span class="text-content/50 shrink-0 font-mono text-sm">{year}</span>
    </div>
    <p class="text-content/75 text-sm">{description}</p>
  </div>
</article>
