---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import ExperienceSticker from '@/components/cards/ExperienceSticker.astro';

const IMAGE_ASSET_BASE = '/src/assets/images/experience/';
const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/experience/*.{png,jpg,jpeg,webp}', { eager: true });

const experienceCollection = await getCollection('experience');
const experiences = experienceCollection
  .map(experience => {
    const src = imageModules[`${IMAGE_ASSET_BASE}${experience.data.icon}`]?.default;
    if (!src) {
      console.warn(`Missing icon for experience "${experience.id}": ${experience.data.icon}`);
      return null;
    }

    return {
      id: experience.id,
      ...experience.data,
      src
    };
  })
  .filter((experience): experience is NonNullable<typeof experience> => experience !== null)
  .sort((a, b) => a.order - b.order);
---

<div class="my-3 flex flex-wrap items-start justify-center gap-x-4 gap-y-8 sm:gap-x-6">
  {
    experiences.map(experience => (
      <ExperienceSticker
        icon={experience.src}
        name={experience.name}
        title={experience.title}
        date={experience.date}
        location={experience.location}
        text={experience.text}
      />
    ))
  }
</div>
