---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import FeaturedProjectCard from '@/components/cards/FeaturedProjectCard.astro';
import ProjectAccordionRow from '@/components/cards/ProjectAccordionRow.astro';
import { PROJECT_CATEGORIES } from '@/consts';

const IMAGE_ASSET_BASE = '/src/assets/images/projects/';
const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/projects/*.{png,jpg,jpeg,webp}', { eager: true });

const projectsCollection = await getCollection('projects');
const projects = projectsCollection
  .map(project => {
    const src = project.data.image.startsWith('http') ? project.data.image : imageModules[`${IMAGE_ASSET_BASE}${project.data.image}`]?.default;
    if (!src) {
      console.warn(`Missing image for project "${project.id}": ${project.data.image}`);
      return null;
    }

    return {
      id: project.id,
      ...project.data,
      src
    };
  })
  .filter((project): project is NonNullable<typeof project> => project !== null);

const byYearDesc = (a: (typeof projects)[number], b: (typeof projects)[number]) => Number(b.year) - Number(a.year);

const featured = projects.filter(project => project.category === 'featured').sort(byYearDesc);

const groups = Object.entries(PROJECT_CATEGORIES)
  .filter(([key]) => key !== 'featured')
  .map(([key, config]) => ({
    key,
    label: config.label,
    defaultOpen: config.defaultOpen,
    items: projects.filter(project => project.category === key).sort(byYearDesc)
  }))
  .filter(group => group.items.length > 0);
---

<div class="my-3 flex flex-col gap-8">
  {
    featured.length > 0 && (
      <section>
        <h3 class="text-content/50 mb-3 font-mono text-xs tracking-wide uppercase">Featured</h3>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map(project => (
            <FeaturedProjectCard
              name={project.name}
              href={project.href}
              source={project.source}
              src={project.src}
              description={project.description}
              year={project.year}
              shortType={project.shortType}
              containImage={project.containImage}
              containBackgroundColor={project.containBackgroundColor}
            />
          ))}
        </div>
      </section>
    )
  }
  {
    groups.map(group => (
      <section>
        <details open={group.defaultOpen} class="group/section">
          <summary class="text-content/60 hover:text-content flex cursor-pointer list-none items-center gap-2 pb-1 select-none marker:content-none [&::-webkit-details-marker]:hidden">
            <Icon name="lucide:chevron-right" size={14} class="shrink-0 transition-transform group-open/section:rotate-90" />
            <span class="font-mono text-xs tracking-wide uppercase">
              {group.label} ({group.items.length})
            </span>
            <span class="bg-content/15 h-px flex-1" />
            <span class="font-mono text-xs uppercase group-open/section:hidden">— show</span>
          </summary>
          <div class="grid pt-1 sm:grid-cols-2 sm:gap-x-6">
            {group.items.map(project => (
              <ProjectAccordionRow
                id={project.id}
                name={project.name}
                href={project.href}
                source={project.source}
                src={project.src}
                description={project.description}
                year={project.year}
                shortType={project.shortType}
                hideMobile={project.hideMobile}
                containImage={project.containImage}
                containBackgroundColor={project.containBackgroundColor}
              />
            ))}
          </div>
        </details>
      </section>
    ))
  }
</div>
